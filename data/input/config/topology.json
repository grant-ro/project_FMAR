{
  "network_id": "CITYNET",
  "network_name": "Rete urbana - città metropolitana",
  "network_description": "Modello astratto di una porzione compatta di grande città composta da 15 incroci a quattro vie. Ogni nodo rappresenta un incrocio che gestisce quattro direttrici; ogni link è una carreggiata a senso unico che collega due incroci. Per ogni collegamento tra due incroci è presente anche il link inverso, che rappresenta la carreggiata separata per il senso opposto. La topologia è regolare e fortemente connessa: ogni nodo ha quattro link uscenti e quattro entranti.",
  "network_goals": [
    {
      "goal_id": "AVOID_CONGESTION",
      "description": "Mantenere la continuità della circolazione tra tutti gli incroci della rete."
    },
    {
      "goal_id": "THROUGHPUT_ORIENTED",
      "description": "Massimizzare i veicoli che raggiungono la destinazione"
    },
    {
      "goal_id": "WAITING_ORIENTED",
      "description": "Ridurre tempo trascorso dai veicoli in attesa."
    },
    {
      "goal_id": "TRAFFIC_BALANCING",
      "description": "Evitare squilibri tra i flussi di traffico."
    }
  ],
