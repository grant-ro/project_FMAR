{
  "network_id": "city_network_001",
  "network_name": "Città Simulata - Centro Urbano",
  "network_description": "Rete stradale urbana direzionale in cui i nodi rappresentano incroci controllati da semafori e i link rappresentano strade a senso unico. Gli obiettivi descrivono i criteri che ogni semaforo può perseguire per migliorare il flusso del traffico.",
  "network_goals": [
    {
      "goal_id": "goal_wait_time",
      "description": "Ridurre il tempo medio di attesa dei veicoli agli incroci."
    },
    {
      "goal_id": "goal_congestion",
      "description": "Prevenire e ridurre la congestione sulle strade in ingresso e in uscita dall'incrocio."
    },
    {
      "goal_id": "goal_throughput",
      "description": "Massimizzare il numero di veicoli che attraversano l'incrocio nell'unità di tempo."
    },
    {
      "goal_id": "goal_pedestrian_safety",
      "description": "Garantire attraversamenti pedonali sicuri e tempi adeguati per i pedoni."
    },
    {
      "goal_id": "goal_emergency_priority",
      "description": "Favorire il passaggio rapido e sicuro dei mezzi di emergenza quando necessario."
    },
    {
      "goal_id": "goal_fairness",
      "description": "Evitare che una direzione del traffico rimanga in attesa troppo a lungo rispetto alle altre."
    },
    {
      "goal_id": "goal_emissions",
      "description": "Ridurre le emissioni limitando soste prolungate, ripartenze frequenti e code."
    }
